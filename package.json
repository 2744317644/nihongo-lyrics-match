{
  "name": "dsh-nihongo-lyrics-match",
  "version": "1.3.10",
  "description": "Japanese/Chinese lyric splitter with centralized LRC backups, a DSH plugin, and an interactive HTML review report. CLI included.",
  "type": "module",
  "license": "MIT",
  "author": "2744317644",
  "repository": {
    "type": "git",
    "url": "https://github.com/2744317644/nihongo-lyrics-match.git"
  },
  "homepage": "https://github.com/2744317644/nihongo-lyrics-match",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "lyrics",
    "japanese",
    "lrc",
    "flac",
    "lyrics-splitter"
  ],
  "bin": {
    "lyrics-split": "./bin/lyrics-split.js",
    "lyrics-migrate-backups": "./bin/migrate-backups.js"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
