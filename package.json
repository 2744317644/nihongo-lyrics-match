    "lib",
    "bin",
    "src",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
